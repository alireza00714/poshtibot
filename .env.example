# Copy to .env. Never commit real secrets.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

ConnectionStrings__Default=Host=localhost;Port=5432;Database=namadno_ai_support;Username=namadno;Password=changeme

LLM__Provider=OpenAICompatible
LLM__BaseUrl=http://localhost:1234/v1
LLM__ApiKey=lm-studio
LLM__Model=qwen2.5-7b-instruct
LLM__TimeoutSeconds=120

Embedding__Provider=OpenAICompatible
Embedding__BaseUrl=http://localhost:1234/v1
Embedding__ApiKey=lm-studio
Embedding__Model=text-embedding-nomic-embed-text-v1.5
Embedding__Dimensions=768
Embedding__TimeoutSeconds=60

Rag__TopK=5
Rag__SimilarityThreshold=0.72
Rag__UseDirectFaqFallback=true

Chat__MaxMessageLength=4000
Chat__MaxConversationContextMessages=20
Chat__MaxTokens=1024
