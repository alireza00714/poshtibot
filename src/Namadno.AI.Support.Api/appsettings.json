{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Namadno": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=namadno_ai_support;Username=namadno;Password=changeme"
  },
  "LLM": {
    "BaseUrl": "http://localhost:1234/v1",
    "ApiKey": "lm-studio",
    "Provider": "OpenAICompatible",
    "Model": "qwen3.5-9b",
    "EnableThinking": false,
    "TimeoutSeconds": 120
  },
  "Embedding": {
    "BaseUrl": "http://localhost:1234/v1",
    "ApiKey": "lm-studio",
    "Provider": "OpenAICompatible",
    "Model": "Qwen3-Embedding-0.6B",
    "Dimensions": 1024,
    "TimeoutSeconds": 60
  },
  "Rag": {
    "TopK": 5,
    "SimilarityThreshold": 0.72,
    "UseDirectFaqFallback": true,
    "DirectFaqExactMatchThreshold": 0.92,
    "VectorWeight": 0.55,
    "KeywordWeight": 0.20,
    "IntentWeight": 0.15,
    "CategoryWeight": 0.05,
    "PriorityWeight": 0.05
  },
  "Chat": {
    "MaxMessageLength": 4000,
    "MaxConversationContextMessages": 20,
    "MaxTokens": 1024,
    "IntentThreshold": 0.75
  },
  "Support": {
    "RequireExplicitConfirmation": true
  },
  "Namadno": {
    "BaseUrl": "https://namadno.example.invalid",
    "TimeoutSeconds": 10,
    "Apis": {
      "UserProfile": "/placeholder/user-profile",
      "InvestmentStatus": "/placeholder/investment-status",
      "FundOrderStatus": "/placeholder/fund-order-status",
      "PaymentStatus": "/placeholder/payment-status",
      "TransferStatus": "/placeholder/transfer-status",
      "CardStatus": "/placeholder/card-status",
      "InsurancePolicy": "/placeholder/insurance-policy"
    }
  },
  "Security": {
    "MaxRequestBodyBytes": 32768,
    "RedactLogs": true
  },
  "RateLimit": {
    "PermitLimit": 30,
    "WindowSeconds": 60
  },
  "DataRetention": {
    "ConversationDays": 365,
    "MessageDays": 365,
    "UnansweredQuestionDays": 730
  },
  "Navigation": {
    "Routes": [
      { "key": "investment", "route": "app://investment" },
      { "key": "leasing", "route": "app://leasing" },
      { "key": "neobank", "route": "app://neobank" },
      { "key": "insurance", "route": "app://insurance" },
      { "key": "public-services", "route": "app://public-services" }
    ]
  },
  "ExternalServices": {
    "Mode": "Mock"
  },
  "Auth": {
    "Strategy": "Development",
    "DevelopmentUserId": "dev-user",
    "GatewayUserIdHeader": "X-User-Id",
    "GatewayPermissionsHeader": "X-Permissions",
    "GatewayRolesHeader": "X-Roles",
    "TrustedHeadersSharedSecretHeader": "X-Internal-Auth",
    "TrustedHeadersSharedSecret": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
