Auth__Strategy=Development
Auth__DevelopmentUserId=dev-user
Auth__JwtAuthority=
Auth__JwtAudience=
Auth__GatewayUserIdHeader=X-User-Id
Auth__TrustedHeadersSharedSecret=

DataRetention__ConversationDays=365
DataRetention__MessageDays=365
